{
	//float vpnrx, vpnry; //SuRgEoN

	if(stereoview)
		fovx += 10; // stereo
	
	RotatePointAroundVectorNEW( frustum[0].normal, frustum[1].normal, vup, vpn, -(90-fovx * 0.5) ); 
	RotatePointAroundVectorNEW( frustum[2].normal, frustum[3].normal, vright, vpn, 90-fovy * 0.5 );
	//TurnVector(frustum[0].normal, vpn, vright, fovx/2 - 90);
	//TurnVector(frustum[1].normal, vpn, vright, 90 - fovx/2);
	//TurnVector(frustum[2].normal, vpn, vup, 90 - fovy/2);
	//TurnVector(frustum[3].normal, vpn, vup, fovy/2 - 90);

