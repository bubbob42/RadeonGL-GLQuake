					if(l>255)
						l=255; //clamp

					l *= 1.0 / 255.0;

					//glColor3f (l, l, l);
					glColor4f (l, l, l, a);

					#endif
				}

				#endif

				// normals and vertexes come from the frame list
				VectorSubtract(verts2->v, verts1->v, d);

				glVertex3f ( verts1->v[0] + (blend * d[0]), 
					verts1->v[1] + (blend * d[1]),	
					verts1->v[2] + (blend * d[2]) );

				verts1++; 
				verts2++;

			} while (--count);
		}

		else
		{
			do 
			{ 
				// texture coordinates come from the draw list 
				glTexCoord2f (((float *)order)[0], ((float *)order)[1]); 
				order += 2; 

				VectorSubtract(verts2->v, verts1->v, d);

				glVertex3f ( verts1->v[0] + (blend * d[0]), 
					verts1->v[1] + (blend * d[1]),	
					verts1->v[2] + (blend * d[2]) );

				verts1++; 
				verts2++;
 
			} while (--count); 
		}

		glEnd (); 
	} 
}

#else

#define NUMVERTEXNORMALS 162

static float r_avertexnormals[NUMVERTEXNORMALS][3] = {
#include "anorms.h"
};


void GL_DrawAliasBlendedFrame (aliashdr_t *paliashdr, int pose1, int pose2, float blend) // 2019 - cowcat
{ 
	#ifdef LITFILES
	float		r,g,b,a; // alpha
	#endif

	float		l;
	trivertx_t	*verts1, *verts2;
	int		*order, count;
	vec3_t		d;

	float baselight = ambientlight * ( 1.0f / 200.0f );
	float temp;
	float alias_forward[3], alias_right[3], alias_up[3];
	float r_plightvec[3], lightvec[3] = {-1, 0, 0};

	currententity->angles[0] = -currententity->angles[0];
	AngleVectors(currententity->angles, alias_forward, alias_right, alias_up);
	currententity->angles[0] = -currententity->angles[0];

	r_plightvec[0] = DotProduct(lightvec, alias_forward);
	r_plightvec[1] = -DotProduct(lightvec, alias_right);
	r_plightvec[2] = DotProduct(lightvec, alias_up);

	a = entalpha; // johnfitz

	lastposenum0 = pose1;
	lastposenum = pose2;

	verts1 = (trivertx_t *)((byte *)paliashdr + paliashdr->posedata);
	verts2 = verts1;

	verts1 += pose1 * paliashdr->poseverts; 
	verts2 += pose2 * paliashdr->poseverts; 

	order = (int *)((byte *)paliashdr + paliashdr->commands); 

	#ifndef LITFILES

	if(!gl_smoothmodels.value) //Surgeon 
	{
		l = shadelight * 1.20;

		if (l > 255)
			l = 255.f;

		l *= 1.f / 255.f;

		glColor3f(l,l,l);
	}

	#else

	if(!gl_smoothmodels.value) //Surgeon
	//if(!smoothmodels)
	{
		if(eyecandy)
		{
			r = (1.2/255.0)*lightcolor[0]; if(r > 1.0) r = 1.0;
			g = (1.2/255.0)*lightcolor[1]; if(g > 1.0) g = 1.0;
			b = (1.2/255.0)*lightcolor[2]; if(b > 1.0) b = 1.0;

			//glColor3f(r,g,b);
			glColor4f(r, g, b, a);
		}

		else
		{
			l = shadelight * 1.20;

			if (l > 255)
				l = 255.f;

			l *= 1.f / 255.f;

			//glColor3f(l,l,l);
			glColor4f(l, l, l, a);
		}
	}

	#endif

	while (1) 
	{ 
		// get the vertex count and primitive type 
		count = *order++;
 
		if (!count) 
			break;	// done

		if (count <  0) 
		{ 
			count = -count; 
			glBegin (GL_TRIANGLE_FAN); 
		}
 
		else
		{ 
			glBegin (GL_TRIANGLE_STRIP); 
		}

		if(gl_smoothmodels.value)
		{
			do 
			{ 
				// texture coordinates come from the draw list 
				glTexCoord2f (((float *)order)[0], ((float *)order)[1]); 
				order += 2;

				// normals and vertexes come from the frame list
				temp = baselight;
				l = DotProduct(r_avertexnormals[verts1->lightnormalindex], r_plightvec);

				//d[0] = r_avertexnormals[verts2->lightnormalindex] - r_avertexnormals[verts1->lightnormalindex];
				//r_avertexnormals[verts1->lightnormalindex] += blend * d[0];
				//l = DotProduct(r_avertexnormals[verts2->lightnormalindex], r_plightvec );

				if(l < 0)
					temp -= shadelight * l;

				glColor4f(temp, temp, temp, a);

				VectorSubtract(verts2->v, verts1->v, d);

				glVertex3f ( verts1->v[0] + (blend * d[0]), 
					verts1->v[1] + (blend * d[1]),	
					verts1->v[2] + (blend * d[2]) );

				verts1++; 
				verts2++;

			} while (--count);
		}

		else
		{
			do 
			{ 
				// texture coordinates come from the draw list 
				glTexCoord2f (((float *)order)[0], ((float *)order)[1]); 
				order += 2; 

				VectorSubtract(verts2->v, verts1->v, d);

				glVertex3f ( verts1->v[0] + (blend * d[0]), 
					verts1->v[1] + (blend * d[1]),	
					verts1->v[2] + (blend * d[2]) );

				verts1++; 
				verts2++;
 
			} while (--count); 
		}

		glEnd (); 
	} 
}

#endif

void GL_DrawAliasFrame (aliashdr_t *paliashdr, int posenum)
{
	#ifdef LITFILES
	float		r,g,b,a; // alpha
	#endif

	float		l;
	trivertx_t	*verts;
	int		*order, count;

	a = entalpha; // johnfitz

	lastposenum = posenum;

	verts = (trivertx_t *)((byte *)paliashdr + paliashdr->posedata);
	verts += posenum * paliashdr->poseverts;
	order = (int *)((byte *)paliashdr + paliashdr->commands);

	#ifndef LITFILES

	if(!gl_smoothmodels.value) //Surgeon 
	{
		l = shadelight * 1.20;

		if (l > 255)
			l = 255.f;

		l *= 1.f / 255.f;

		glColor3f(l,l,l);
	}

	#else

	if(!gl_smoothmodels.value) //Surgeon
	//if(!smoothmodels)
	{
		if(eyecandy)
		{
			r = (1.2/255.0)*lightcolor[0]; if(r > 1.0) r = 1.0;
			g = (1.2/255.0)*lightcolor[1]; if(g > 1.0) g = 1.0;
			b = (1.2/255.0)*lightcolor[2]; if(b > 1.0) b = 1.0;

			//glColor3f(r, g, b);
			glColor4f(r, g, b, a);
		}

		else
		{
			l = shadelight * 1.20;

			if (l > 255)
				l = 255.f;

			l *= 1.f / 255.f;

			//glColor3f(l, l, l);
			glColor4f(l, l, l, a);
		}
	}

	#endif

	while (1)
	{
		// get the vertex count and primitive type
		count = *order++;

		if (!count)
			break;	  // done

		if (count < 0)
		{
			count = -count;
			glBegin (GL_TRIANGLE_FAN);
		}

		else
		{
			glBegin (GL_TRIANGLE_STRIP);
		}

		// Surgeon: HACK - flatshading implemented - works fine

		if (gl_smoothmodels.value)
		//if (smoothmodels) // Cowcat 2019
		{
			do
			{
				// texture coordinates come from the draw list
				glTexCoord2f (((float *)order)[0], ((float *)order)[1]); 
				order += 2;

				// normals and vertexes come from the frame list

				#ifndef LITFILES

				l = shadedots[verts->lightnormalindex] * shadelight;

				//printf("%f\n", l); //for debugging

				if(l>255)
					l=255; //clamp

				l *= 1.0/255.0;

				glColor3f (l, l, l);

				#else

				if(eyecandy)
				{
					l = shadedots[verts->lightnormalindex]*(1.0/255.0);

					r = l*lightcolor[0]; if(r > 1.0) r = 1.0;
					g = l*lightcolor[1]; if(g > 1.0) g = 1.0;
					b = l*lightcolor[2]; if(b > 1.0) b = 1.0;

					//glColor3f(r,g,b);
					glColor4f (r, g, b, a);
				}

				else
				{
					l = shadedots[verts->lightnormalindex] * shadelight;

					if(l>255)
						l=255; //clamp

					l *= 1.0 / 255.0;

					//glColor3f (l, l, l);
					glColor4f (l, l, l, a);
				}

				#endif

				glVertex3f (verts->v[0], verts->v[1], verts->v[2]);

				verts++;

			} while (--count);
		}

		else //moved glColor outside loop
		{
			do
			{
				// texture coordinates come from the draw list
				glTexCoord2f (((float *)order)[0], ((float *)order)[1]); 
				order += 2;

				glVertex3f (verts->v[0], verts->v[1], verts->v[2]);

				verts++;

			} while (--count);
		}

		glEnd ();
	}
}



